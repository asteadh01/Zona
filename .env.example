# Copy to .env for local runs: uvicorn zona.main:app --env-file .env
# Never commit .env. On Cloud Run these come bundled as one Secret Manager secret (ZONA_SECRETS), set by
# scripts/zona_cloud.py, which also sets ZONA_STORE=firestore, ZONA_SYNC=0 and ZONA_TICK_SECRET.

# Garmin Connect web > Settings > Personal API Key. Leave empty and set ZONA_FAKE=1 to run on sample data.
GARMIN_PERSONAL_API_KEY=
ZONA_FAKE=1

# The one password that opens the app (12+ characters), and the secret that signs its session tokens.
# Zona refuses to start with these placeholder values. Secret: python -c "import secrets;print(secrets.token_urlsafe(48))"
ZONA_PASSWORD=change-me
ZONA_SESSION_SECRET=replace-with-64-random-characters

ZONA_TZ=America/Santiago
ZONA_DATA_DIR=./data
# sqlite (local) or firestore (needs Google credentials, or FIRESTORE_EMULATOR_HOST for the emulator)
ZONA_STORE=sqlite
# Only for trying the app in a browser with `expo start --web`:
ZONA_DEV_CORS_ORIGIN=http://localhost:8081
