# Copy to .env for local runs: uvicorn zona.main:app --env-file .env
# Never commit .env. In k3s these come from the zona-secrets Secret.

# Garmin Connect web > Settings > Personal API Key. Leave empty and set ZONA_FAKE=1 to run on sample data.
GARMIN_PERSONAL_API_KEY=
ZONA_FAKE=1

# The one password that opens the app (12+ characters), and the secret that signs its session cookie.
# Zona refuses to start with these placeholder values. Secret: python -c "import secrets;print(secrets.token_urlsafe(48))"
ZONA_PASSWORD=change-me
ZONA_SESSION_SECRET=replace-with-64-random-characters

# Web push. Generate with: python -m zona vapid. The subject is a contact of yours the push services can reach;
# it goes only to them, inside the signed push request.
ZONA_VAPID_PRIVATE_KEY=
ZONA_VAPID_PUBLIC_KEY=
ZONA_VAPID_SUBJECT=mailto:you@example.com

ZONA_TZ=America/Santiago
ZONA_DATA_DIR=./data
# Local http://localhost needs non-secure cookies. Keep 1 anywhere served over https.
ZONA_SECURE_COOKIES=0
